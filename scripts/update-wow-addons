#!/usr/bin/env nix
#! nix shell --inputs-from . nixpkgs#python3 nixpkgs#nix-prefetch-scripts nixpkgs#subversion --command python3
"""Update the pinned addon URLs and hashes in pkgs/wow-addons/*.nix."""

import json
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path


ROOT = Path(__file__).parent.parent
PACKAGE_DIR = ROOT / "pkgs/wow-addons"
GITHUB_TOKEN = Path.home() / ".config/wow-addons/github-token"


def fetch_json(url: str, github: bool = False):
    headers = {"User-Agent": "flake-update-wow-addons"}
    if github:
        headers["Accept"] = "application/vnd.github+json"
        if GITHUB_TOKEN.exists():
            headers["Authorization"] = f"Bearer {GITHUB_TOKEN.read_text().strip()}"
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request) as response:
        return json.load(response)


def release_assets(release: dict, repo: str = "") -> list[dict]:
    excluded_variants = r"classic|vanilla|bcc|tbc|wotlk|wrath|cata|mists|mop"
    if repo.rsplit("/", 1)[-1].lower().endswith("_classic"):
        excluded_variants = r"vanilla|bcc|tbc|wotlk|wrath|cata|mists|mop"
    return [
        asset
        for asset in release.get("assets", [])
        if asset["name"].endswith(".zip")
        and not re.search(
            rf"(?i)[-_.]({excluded_variants})\b|nolib",
            asset["name"],
        )
    ]


def github_release(repo: str) -> str:
    for release in fetch_json(
        f"https://api.github.com/repos/{repo}/releases?per_page=10", github=True
    ):
        zips = release_assets(release, repo)
        if not release.get("draft") and not release.get("prerelease") and zips:
            return zips[0]["browser_download_url"]
    raise RuntimeError(f"no suitable GitHub release found for {repo}")


def latest_github_release(
    repo: str, old_revision: str, old_asset: str
) -> tuple[str, str, str]:
    """Return the tag, asset name, and URL for the newest stable release."""
    for release in fetch_json(
        f"https://api.github.com/repos/{repo}/releases?per_page=10", github=True
    ):
        if release.get("draft") or release.get("prerelease"):
            continue
        assets = release_assets(release, repo)
        tag = release["tag_name"]
        # Prefer the same asset renamed for the new release. This avoids
        # accidentally switching to a Classic/no-lib variant when a release
        # contains more than one ZIP.
        expected_name = old_asset.replace(old_revision, tag)
        matching = [asset for asset in assets if asset["name"] == expected_name]
        if not matching and len(assets) == 1:
            matching = assets
        if matching:
            asset = matching[0]
            return tag, asset["name"], asset["browser_download_url"]
    raise RuntimeError(f"no suitable stable GitHub release found for {repo}")


def github_source_hash(owner: str, repo: str, rev: str) -> str:
    url = f"https://github.com/{owner}/{repo}/archive/refs/tags/{rev}.tar.gz"
    return subprocess.run(
        ["nix-prefetch-url", "--unpack", url],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip().splitlines()[0]


def latest_github_revision(repo: str) -> str:
    releases = fetch_json(
        f"https://api.github.com/repos/{repo}/releases?per_page=10", github=True
    )
    for release in releases:
        if not release.get("draft") and not release.get("prerelease"):
            return release["tag_name"]
    raise RuntimeError(f"no stable GitHub release found for {repo}")


def latest_url(url: str, kind: str) -> tuple[str, str | None, str | None]:
    if kind == "svnAddon":
        revision = subprocess.run(
            ["svn", "info", "--show-item", "revision", url],
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
        return url, revision, None
    if "github.com/" in url:
        repo = url.split("github.com/", 1)[1].split("/releases/", 1)[0]
        return github_release(repo), None, None
    if "wowinterface.com/downloads/getfile.php" in url:
        file_id = re.search(r"[?&]id=(\d+)", url).group(1)
        metadata = fetch_json(
            f"https://api.mmoui.com/v3/game/WOW/filedetails/{file_id}.json"
        )[0]
        return metadata["UIDownload"], None, metadata["UIVersion"].removeprefix("v")
    return url, None, None


def prefetch(url: str) -> str:
    return subprocess.run(
        ["nix-prefetch-url", "--name", "source.zip", url],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip().splitlines()[-1]


def prefetch_svn(url: str, revision: str) -> str:
    return subprocess.run(
        ["nix-prefetch-svn", url, revision],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip().splitlines()[-1]


def replace_field(block: str, field: str, value: str) -> str:
    return re.sub(
        rf'(\b{re.escape(field)}\s*=\s*")[^"]*(";)',
        rf'\g<1>{value}\g<2>',
        block,
        count=1,
    )


def field(block: str, field_name: str, addon_name: str) -> str:
    match = re.search(rf'\b{re.escape(field_name)}\s*=\s*"([^"]+)";', block)
    if match is None:
        raise ValueError(f"{addon_name}: missing required field {field_name!r}")
    return match.group(1)


def main() -> None:
    addon_files = sorted(PACKAGE_DIR.rglob("*.nix"))
    addon_files = [path for path in addon_files if path.name != "default.nix"]
    if not addon_files:
        raise SystemExit(f"no addon definitions found in {PACKAGE_DIR}")

    standalone_entry_pattern = re.compile(
        r"(?ms)^\{[^}]+\}:\s*"
        r"(githubAddon|githubReleaseAddon|zipAddon|svnAddon)\s*\{(.*?)\}\s*$"
    )
    grouped_entry_pattern = re.compile(
        r"(?ms)^\s*[A-Za-z0-9_-]+\s*=\s*"
        r"(githubAddon|githubReleaseAddon|zipAddon|svnAddon)\s*\{(.*?)\};"
    )

    for package_file in addon_files:
        content = package_file.read_text()
        matches = list(grouped_entry_pattern.finditer(content))
        if not matches:
            match = standalone_entry_pattern.fullmatch(content)
            if match is None:
                raise ValueError(f"{package_file}: could not parse addon definition")
            matches = [match]

        replacements = []
        for match in matches:
            kind, block = match.group(1), match.group(2)
            original_block = block
            addon_name_match = re.search(r'\bname\s*=\s*"([^"]+)";', block)
            addon_name = addon_name_match.group(1) if addon_name_match else package_file.stem
            new_url = None
            revision = None
            if kind == "githubAddon":
                owner = field(block, "owner", addon_name)
                repo = field(block, "repo", addon_name)
                old_revision = field(block, "rev", addon_name)
                revision = latest_github_revision(f"{owner}/{repo}")
                if revision != old_revision:
                    block = replace_field(block, "rev", revision)
                    block = replace_field(
                        block, "hash", github_source_hash(owner, repo, revision)
                    )
            elif kind == "githubReleaseAddon":
                owner = field(block, "owner", addon_name)
                repo = field(block, "repo", addon_name)
                old_revision = field(block, "rev", addon_name)
                source_archive = re.search(
                    r"\bsourceArchive\s*=\s*true;", block
                )
                if source_archive:
                    revision = latest_github_revision(f"{owner}/{repo}")
                    asset = None
                    url = (
                        f"https://github.com/{owner}/{repo}/archive/refs/tags/"
                        f"{revision}.zip"
                    )
                    changed = revision != old_revision
                else:
                    old_asset = field(block, "asset", addon_name)
                    revision, asset, url = latest_github_release(
                        f"{owner}/{repo}", old_revision, old_asset
                    )
                    changed = revision != old_revision or asset != old_asset
                if changed:
                    block = replace_field(block, "rev", revision)
                    if asset is not None:
                        block = replace_field(block, "asset", asset)
                    block = replace_field(block, "sha256", prefetch(url))
                    if source_archive:
                        block = replace_field(
                            block, "subdir", f"{addon_name}-{revision.removeprefix('v')}"
                        )
            else:
                url = field(block, "url", addon_name)
                new_url, revision, version = latest_url(url, kind)
                old_version = re.search(r'\bversion\s*=\s*"([^"]+)";', block)
                version_changed = version is not None and (
                    old_version is None or old_version.group(1) != version
                )
                if new_url != url or version_changed:
                    if new_url != url:
                        new_hash = prefetch(new_url)
                        block = replace_field(block, "url", new_url)
                        block = replace_field(block, "sha256", new_hash)
                    if version_changed:
                        block = replace_field(block, "version", version)
            if kind == "svnAddon" and revision is not None:
                old_revision = field(block, "rev", addon_name)
                if revision != old_revision:
                    new_hash = prefetch_svn(new_url, revision)
                    block = replace_field(block, "rev", revision)
                    block = replace_field(block, "sha256", new_hash)
            if block != original_block:
                print(f"updated {addon_name}")
                replacements.append((match.start(2), match.end(2), block))

        for start, end, block in reversed(replacements):
            content = content[:start] + block + content[end:]
        if replacements:
            package_file.write_text(content)


if __name__ == "__main__":
    try:
        main()
    except (
        RuntimeError,
        subprocess.CalledProcessError,
        urllib.error.URLError,
        ValueError,
    ) as error:
        sys.exit(f"error: {error}")
